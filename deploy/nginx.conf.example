# =====================================================================
# Nginx vhosts for the USO stack.
#
# Multi-site via WILDCARD: ONE USO Portal vhost serves EVERY subdomain
# (portal / site1 / site2 / … siteN.vodafonefiji.cloud) through a wildcard
# server_name. The backend tells the sites apart from the forwarded Host
# header, so a NEW site needs ZERO changes here — DNS, TLS and nginx already
# cover it. Adding a site = add it in the admin (Network > Add site) + upload
# its captive HTML in Ruijie.
#
# Hostnames:
#   - *.vodafonefiji.cloud     → public captive-portal payment app
#                                (USO Portal frontend + /api/* + /payment/* to :5000)
#   - admin.vodafonefiji.cloud → internal admin dashboard (exact match wins)
#                                (VV frontend + /api/* to :4001)
#
# Place at: /etc/nginx/sites-available/uso-stack
# Symlink:  sudo ln -s /etc/nginx/sites-available/uso-stack /etc/nginx/sites-enabled/
# Test:     sudo nginx -t
# Reload:   sudo systemctl reload nginx
#
# SSL — ONE wildcard cert covers every subdomain. Wildcards require a DNS-01
# challenge; on Cloudflare that's automatic via the certbot Cloudflare plugin
# (full steps in deploy/MULTISITE.md):
#   sudo certbot certonly --dns-cloudflare \
#     --dns-cloudflare-credentials /root/.secrets/cloudflare.ini \
#     -d 'vodafonefiji.cloud' -d '*.vodafonefiji.cloud'
#   → /etc/letsencrypt/live/vodafonefiji.cloud/{fullchain,privkey}.pem
#   Point the ssl_certificate / ssl_certificate_key in your 443 blocks there.
#
# IMPORTANT:
#   - Cloudflare: ONE wildcard A record  *.vodafonefiji.cloud → <server IP>
#     (DNS only / grey cloud) so every siteN resolves automatically.
#   - Keep `proxy_set_header Host $host;` — the backend resolves which site
#     (and thus which plans/vouchers) from it.
#   - /var/www/uso-portal → wherever you cloned the repo.
# =====================================================================

upstream uso_backend {
    server 127.0.0.1:5000;
    keepalive 32;
}

upstream vv_backend {
    server 127.0.0.1:4001;
    keepalive 32;
}

# =====================================================================
# Public Portal — ALL site subdomains via ONE wildcard server_name.
# A new siteN.vodafonefiji.cloud is served automatically (no edit here).
# The exact `admin` block below wins for admin.* (exact match > wildcard).
# =====================================================================
server {
    listen 80;
    listen [::]:80;
    server_name *.vodafonefiji.cloud;

    root /var/www/uso-portal/uso-portal/frontend/build;
    index index.html;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    client_max_body_size 2m;

    location /assets/ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~ ^/(api|payment)/ {
        proxy_pass         http://uso_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;   # ← backend resolves the site from this
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml+rss image/svg+xml;
}

# =====================================================================
# Admin Dashboard — admin.vodafonefiji.cloud
# Restrict by IP / VPN / basic auth in production (this app handles
# voucher management and user creation).
# =====================================================================
server {
    listen 80;
    listen [::]:80;
    server_name admin.vodafonefiji.cloud;

    root /var/www/uso-portal/voucher-validation/frontend/build;
    index index.html;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    client_max_body_size 5m;

    # Site documents (handover packs, as-builts) are uploaded as a raw stream and
    # can reach 100 MB. Scoped to this one path so every other endpoint keeps the
    # small default — a body limit is a denial-of-service control, not a
    # formality. proxy_request_buffering off streams straight through instead of
    # spooling the whole upload to a temp file first, which is the point of
    # streaming it in the first place.
    location ~ ^/api/maintenance/villages/[0-9]+/documents/?$ {
        client_max_body_size 105m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass         http://vv_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # OPTIONAL — uncomment + edit to allowlist your office/VPN IPs only.
    # allow 203.0.113.0/24;
    # deny all;

    location /assets/ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass         http://vv_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml+rss image/svg+xml;
}
