# =====================================================================
# Nginx vhosts for the USO stack.
#
# Multi-site: ONE USO Portal vhost serves EVERY site domain
# (portal / site1 / site2 / … siteN.vodafonefiji.cloud). The backend tells
# the sites apart from the forwarded Host header, so adding a site = adding
# its domain to the USO `server_name` below (+ a cert). No new vhost per site.
#
# Hostnames:
#   - portal / site1 / site2 / … .vodafonefiji.cloud
#                              → public captive-portal payment app
#                                (USO Portal frontend + /api/* + /payment/* to :5000)
#   - admin.vodafonefiji.cloud → internal admin dashboard
#                                (VV frontend + /api/* to :4001)
#
# Place at: /etc/nginx/sites-available/uso-stack
# Symlink:  sudo ln -s /etc/nginx/sites-available/uso-stack /etc/nginx/sites-enabled/
# Test:     sudo nginx -t
# Reload:   sudo systemctl reload nginx
#
# SSL (list every site domain + admin in ONE cert):
#   sudo certbot --nginx \
#     -d portal.vodafonefiji.cloud -d site1.vodafonefiji.cloud \
#     -d site2.vodafonefiji.cloud -d admin.vodafonefiji.cloud
#   Certbot adds the 443 blocks + HTTP→HTTPS redirects in place.
#   Adding a later site: re-run certbot with --expand and the extra -d.
#
# IMPORTANT:
#   - The DNS A record for each site domain must point at the server FIRST,
#     or certbot's challenge fails.
#   - Add each new site's domain to the USO `server_name` line (+ cert).
#   - Keep `proxy_set_header Host $host;` — the backend resolves which site
#     (and thus which plans/vouchers) from it. Without it every site would
#     fall back to site1.
#   - /var/www/uso-portal → wherever you cloned the repo.
# =====================================================================

upstream uso_backend {
    server 127.0.0.1:5000;
    keepalive 32;
}

upstream vv_backend {
    server 127.0.0.1:4001;
    keepalive 32;
}

# =====================================================================
# Public Portal — ALL site domains (one vhost; backend resolves by Host)
#   Add new sites to this server_name line:
#     server_name portal... site1... site2... site3... ;
# =====================================================================
server {
    listen 80;
    listen [::]:80;
    server_name portal.vodafonefiji.cloud site1.vodafonefiji.cloud site2.vodafonefiji.cloud;

    root /var/www/uso-portal/uso-portal/frontend/build;
    index index.html;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    client_max_body_size 2m;

    location /assets/ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~ ^/(api|payment)/ {
        proxy_pass         http://uso_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;   # ← backend resolves the site from this
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml+rss image/svg+xml;
}

# =====================================================================
# Admin Dashboard — admin.vodafonefiji.cloud
# Restrict by IP / VPN / basic auth in production (this app handles
# voucher management and user creation).
# =====================================================================
server {
    listen 80;
    listen [::]:80;
    server_name admin.vodafonefiji.cloud;

    root /var/www/uso-portal/voucher-validation/frontend/build;
    index index.html;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    client_max_body_size 5m;

    # OPTIONAL — uncomment + edit to allowlist your office/VPN IPs only.
    # allow 203.0.113.0/24;
    # deny all;

    location /assets/ {
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass         http://vv_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml+rss image/svg+xml;
}
