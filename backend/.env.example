# =========================================
# USO Portal Backend — environment template
# Copy this to `.env` and fill real values.
# =========================================

# Application
NODE_ENV=production
PORT=5000

# Trust X-Forwarded-* from Nginx (use "1" when behind a single proxy hop).
TRUST_PROXY=1

# CORS — comma-separated list of allowed origins.
# Leave blank to allow all origins (NOT recommended in prod).
# Example: https://portal.example.com,https://www.example.com
CORS_ORIGIN=https://portal.example.com

# M-PAiSA Payment Gateway
MPAISA_BASE_URL=https://pay.mpaisa.vodafone.com.fj/live/
MPAISA_CLIENT_ID=00000
MPAISA_SECRET_KEY=replace_with_real_secret
# Public URL the user is redirected back to after payment.
# Must match the route that handles /payment-result on the frontend.
MPAISA_RETURN_URL=https://portal.example.com/payment-result

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=uso_user
DB_PASSWORD=replace_with_real_password
DB_NAME=uso_project

# Voucher Validation API
VOUCHER_VALIDATION_API_URL=http://localhost:4001
PORTAL_API_SECRET=replace_with_shared_secret_with_vv

# Ruijie captive-portal auth endpoint (override if you move regions).
RUIJIE_AUTH_URL=https://portal-ap.ruijienetworks.com/api/auth/general

# Support contact shown to customers when manual assistance is required.
SUPPORT_PHONE=+679-SUPPORT
