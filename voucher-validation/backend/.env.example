# ============================================================
# Voucher Validation API — environment template
# Copy this to `.env` and fill in real values.
# ============================================================

# Server
NODE_ENV=production
PORT=4001

# Trust X-Forwarded-* from Nginx (use "1" when behind a single proxy hop).
TRUST_PROXY=1

# CORS — comma-separated list of allowed origins.
# Example: https://admin.example.com,https://portal.example.com
# (Portal needs access for /api/portal/* calls; admin dashboard for the rest.)
CORS_ORIGIN=https://admin.example.com

# MySQL
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=vv_user
DATABASE_PASSWORD=replace_with_real_password
DATABASE_NAME=voucher_management

# JWT — used to sign admin login tokens (rotate periodically).
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_string

# ── Two-factor authentication ───────────────────────────────────────────────
# Encrypts the TOTP secrets at rest. WITHOUT this they are stored in plaintext
# and anyone who can read the users table can generate valid codes for every
# enrolled account — the backend says so, loudly, at startup.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Then seal the rows already stored:
#   node scripts/encrypt-totp-secrets.mjs --apply
#
# There is NO fallback and no key is ever generated at boot: a key that can be
# silently absent means every stored secret becomes undecryptable on the next
# restart, and nobody finds out until the whole estate is locked out.
#
# LOSING THIS KEY means losing every enrolled second factor — each account then
# needs its two-factor reset from the Users page. Keep it with the deployment's
# secret material, not only in this one file on this one box.
TOTP_ENCRYPTION_KEY=

# Previous keys, comma-separated, kept only so already-stored secrets can still
# be read during a rotation. Set the new key above, move the old one here,
# restart, re-run the script, then clear this.
TOTP_ENCRYPTION_KEY_OLD=

# How long two-factor audit events are kept, in days. Default 365.
TWO_FACTOR_LOG_DAYS=365

# Ruijie Cloud API credentials
RUIJIE_API_BASE_URL=https://cloud-ap.ruijienetworks.com/service/api
RUIJIE_APP_ID=
RUIJIE_APP_SECRET=
RUIJIE_GROUP_ID=
RUIJIE_TENANT_ID=

# Shared secret with USO Portal — must match PORTAL_API_SECRET in uso-portal/backend/.env.
# Generate with: openssl rand -hex 32
PORTAL_API_SECRET=replace_with_shared_secret_matching_uso_portal
